{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "target": "ES2022",
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e"
  ]
}
